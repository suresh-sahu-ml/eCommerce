<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="002-create-product-sequence" author="architect">
        <createSequence sequenceName="product_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="002-create-products-table" author="architect">
        <createTable tableName="products">
            <column name="product_id" type="number(19,0)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="varchar(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_sku"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="price" type="number(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="stock_quantity" type="number(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="brand" type="varchar(100)"/>
            <column name="volume_ml" type="number(5,0)"/>
            <column name="is_active" type="number(1,0)" defaultValue="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-product-indexes" author="architect">
        <createIndex indexName="idx_product_name" tableName="products">
            <column name="product_name"/>
        </createIndex>
        <!-- Index on SKU automatically created by unique constraint -->
    </changeSet>

</databaseChangeLog>
