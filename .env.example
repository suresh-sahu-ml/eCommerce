# Resend Email Service Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_ENABLED=true
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@perfumeshop.com

# Database Configuration
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=system
DB_PASSWORD=your-database-password-change-this

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-with-at-least-32-characters-long
JWT_EXPIRATION=86400000

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/perfume-shop
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/perfume-shop/protocol/openid-connect/certs

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id-from-dashboard
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-from-dashboard
